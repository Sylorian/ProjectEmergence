    tags:
    - "\u6728"
    - "\u5E03"
    clues:
    - "\u4E00\u5F20\u65E7\u5E8A\u3002\u88AB\u5B50\u6380\u5F00\u7740\uFF0C\u50CF\u662F\u521A\u521A\u6709\u4EBA\u8D77\u8EAB\u79BB\u5F00\u3002"
  - id: 8
    name: "\u50A8\u85CF\u5BA4\u95E8"
