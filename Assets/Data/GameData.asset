    - "\u5149\u6E90"
    - "\u53EF\u5F00\u5173"
    - "\u5173\u95ED"
    clues:
    - "\u684C\u4E0A\u7684\u53F0\u706F\uFF0C\u4F3C\u4E4E\u5DF2\u7ECF\u7528\u4E86\u5F88\u4E45\u4E86\uFF0C\u4F46\u5B83\u7684\u4E3B\u4EBA\u6682\u65F6\u4E5F\u6CA1\u6709\u66F4\u6362\u7684\u8BA1\u5212\u3002\u53EF\u4EE5\u6253\u5F00\u6216\u8005\u5173\u95ED\uFF0C\u7531\u6253\u51FA\u7684\u53E5\u5B50\u8BF4\u4E86\u7B97\u3002"
