    - "\u5BB9\u5668"
    clue: "\u4E00\u4E2A\u5E26\u56DB\u4F4D\u5BC6\u7801\u9501\u7684\u7BB1\u5B50\u3002\u4F3C\u4E4E\u653E\u7740\u4E9B\u91CD\u8981\u7684\u4E1C\u897F\uFF0C\u4E0D\u8BBA\u662F\u5173\u4E8E\u7406\u60F3\uFF0C\u8FD8\u662F\u8FDC\u65B9\u3002\n\u6211\u6CA1\u6709\u8BBE\u7F6E\u8FC7\u5BC6\u7801\u3002\u8FD9\u9501\u662F\u54EA\u6765\u7684\uFF1F\u5982\u679C\u5B83\u662F\u6728\u8D28\u7684\u5C31\u597D\u4E86\uFF0C\u6216\u8BB8\u5C31\u53EF\u4EE5\u76F4\u63A5\u4E00\u628A\u706B\u70E7\u4E86\u5B83\u3002"
