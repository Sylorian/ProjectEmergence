  entities:
  - id: 0
    name: "\u7A97\u6237"
    pinyin: chuanghu
    room: "\u5367\u5BA4"
    tags:
    - "\u73BB\u7483"
    - "\u53EF\u8FDE\u63A5"
    clues:
    - "\u7D27\u95ED\u7684\u7A97\u6237\uFF0C\u63D2\u9500\u4E0A\u6709\u4E00\u5C42\u8106\u7684\u9508\u75D5\uFF0C\u98A4\u98A4\u5DCD\u5DCD\u5730\u62B5\u5FA1\u7740\u5BD2\u51AC\u7684\u98CE\u96EA\u3002\u5982\u679C\u8BD5\u7740\u6253\u5F00\u5B83\uFF0C\u4F1A\u600E\u4E48\u6837\u5462\uFF1F"
    - "\u5DF2\u7ECF\u88AB\u6253\u788E\u7684\u7A97\u6237\uFF0C\u5982\u679C\u6211\u60F3\u8981\u4E0B\u53BB\uFF0C\u6211\u8FD8\u9700\u8981\u7528\u7EF3\u5B50\u8FDE\u63A5\u5B83\u3002"
    - "\u5DF2\u7ECF\u8FDE\u63A5\u4E86\u7EF3\u5B50\u7684\u7A97\u6237\uFF0C\u5982\u679C\u6211\u60F3\u8981\u51FA\u53BB\uFF0C\u6211\u8FD8\u9700\u8981\u7528\u9524\u5B50\u6253\u788E\u5B83\u3002"
  - id: 1
    name: "\u6253\u5B57\u673A"
    pinyin: daziji
    room: "\u5367\u5BA4"
    tags:
    - "\u7F16\u5199"
    clues:
    - "\u4E00\u53F0\u5D2D\u65B0\u7684\u6253\u5B57\u673A\uFF0C\u5B83\u4E0D\u8BE5\u5728\u8FD9\u91CC\u2014\u2014\u6CA1\u6709\u4EBA\u62A5\u5907\u8FC7\uFF0C\u4E5F\u6CA1\u6709\u7F16\u53F7\u3002\n\u6216\u8BB8\u8BE5\u518D\u8BD5\u8BD5\u90A3\u53F0\u8BE1\u5F02\u7684\u6253\u5B57\u673A\u4E86\u3002\n\u8FD9\u4E9B\u602A\u4E8B\uFF0C\u90FD\u662F\u5B83\u51ED\u7A7A\u51FA\u73B0\u5728\u6211\u5BB6\u4E4B\u540E\u627E\u4E0A\u95E8\u6765\u7684\u3002\n\u6211\u8981\u662F\u5BF9\u7740\u4F60\u8F93\u5165\u2018\u8D70\u51FA\u5BB6\u95E8\u2019\uFF0C\u4F60\u4F1A\u50CF\u524D\u51E0\u6B21\u90A3\u6837\u542C\u8BDD\u5730\u5E94\u9A8C\u5417\uFF1F"
    - "\u4E00\u53F0\u5D2D\u65B0\u7684\u6253\u5B57\u673A\u3002\u4E00\u5207\u7531\u5B83\u5F00\u59CB\u3002"
  - id: 2
    name: "\u5BC6\u7801\u7BB1"
    pinyin: mimaxiang
    room: "\u5367\u5BA4"
    tags:
    - "\u5BC6\u7801\u9501"
    - "\u5BB9\u5668"
    clues:
    - "\u4E00\u4E2A\u5E26\u56DB\u4F4D\u5BC6\u7801\u9501\u7684\u7BB1\u5B50\u3002\u4F3C\u4E4E\u653E\u7740\u4E9B\u91CD\u8981\u7684\u4E1C\u897F\uFF0C\u4E0D\u8BBA\u662F\u5173\u4E8E\u7406\u60F3\uFF0C\u8FD8\u662F\u8FDC\u65B9\u3002\n\u6211\u6CA1\u6709\u8BBE\u7F6E\u8FC7\u5BC6\u7801\u3002\u8FD9\u9501\u662F\u54EA\u6765\u7684\uFF1F\u5982\u679C\u5B83\u662F\u6728\u8D28\u7684\u5C31\u597D\u4E86\uFF0C\u6216\u8BB8\u5C31\u53EF\u4EE5\u76F4\u63A5\u4E00\u628A\u706B\u70E7\u4E86\u5B83\u3002"
    - "\u88AB\u6253\u5F00\u7684\u5BC6\u7801\u7BB1\u3002"
  - id: 3
    name: "\u732B\u5934\u9E70"
    pinyin: maotouying
    room: "\u5367\u5BA4"
    tags:
    - "\u6D3B\u7269"
    clues:
    - "\u8FD9\u662F\u4EC0\u4E48\uFF1F\u4E00\u53EA\u732B\u5934\u9E70\uFF1F\u5B83\u505C\u5728\u8863\u67DC\u9876\u4E0A\u3002\u5B89\u9759\u5730\u6CE8\u89C6\u7740\u4E00\u5207\u3002\n\u4F60\u786E\u5B9A\uFF0C\u5BB6\u91CC\u4ECE\u6CA1\u6709\u517B\u8FC7\u732B\u5934\u9E70\u3002\u5B83\u662F\u6D3B\u7269\uFF0C\u6D3B\u7269\u610F\u5473\u7740\u53EF\u4EE5\u4E0E\u5176\u4E92\u52A8\uFF0C\u5982\u679C\u6D3B\u7269\u8DB3\u591F\u806A\u6167\uFF0C\u751A\u81F3\u53EF\u4EE5\u4E0E\u5176\u4EA4\u8C08......"
  - id: 4
