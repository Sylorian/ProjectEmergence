    clue: "\u201C\u665A\u95F4\u65B0\u95FB\u4E3A\u60A8\u62A5\u9053\u2026\u2026\u201D\n\u201C\u2026\u2026\u4ECA\u5E74\uFF0C\u6211\u56FD\u5DE5\u4E1A\u603B\u4EA7\u503C\u8F83\u53BB\u5E74\u540C\u671F\u589E\u957F\u767E\u5206\u4E4B\u4E03\u70B9\u56DB\u2026\u2026\u201D\n\u201C\u2014\u2014\u4F60\u8BF4\u60F3\u6211\u2014\u2014\u6211\u5C31\u6765\u4E86\u3002\u201D\n\u2014\u2014\u64AD\u62A5\u5458\u8BF4\u4E86\u4EC0\u4E48\uFF1F\uFF01\u90A3\u548C\u521A\u624D\u5988\u5988\u8BF4\u8FC7\u7684\u8BDD\u4E00\u6A21\u4E00\u6837\uFF01\u64AD\u62A5\u5458\u5634\u91CC\u50CF\u662F\u6709\u4E00\u652F\u5C0F\u5F39\u7C27\uFF0C\u628A\u8FD9\u4E9B\u6D88\u606F\u5168\u90E8\u90FD\u8F7B\u5DE7\u5730\u5410\u51FA\u6765\uFF0C\u7535\u89C6\u5C4F\u5E55\u6CA1\u6709\u4EFB\u4F55\u5F02\u5E38\u3002"
