    room: "\u5BA2\u5385"
    tags:
    - "\u9501"
    - "\u95E8"
    clues:
    - "\u901A\u5F80\u50A8\u85CF\u5BA4\u7684\u95E8\uFF0C\u4E0A\u9501\u4E86\u3002\u8FD9\u91CC\u7684\u94A5\u5319\u4E00\u822C\u90FD\u662F\u88AB\u6211\u968F\u8EAB\u5E26\u7740\u7684\uFF0C\u4E0D\u89C1\u4E86......\u94A5\u5319\u53BB\u54EA\u4E86\uFF1F\u96BE\u9053\u662F\u88AB\u5988\u5988\u62FF\u8D70\u4E86\uFF1F"
  - id: 9
    name: "\u6536\u97F3\u673A"
    pinyin: shouyinji
    room: "\u5BA2\u5385"
    tags:
    - "\u58F0\u6E90"
    clues:
    - "\u201C\u5929\u6C14\u9884\u62A5\uFF1A\u4ECA\u591C\u6709\u96EA\uFF0C\u6C14\u6E29\u96F6\u4E0B\u5341\u4E5D\u5EA6\u3002\u660E\u65E5\u8F6C\u6674\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u201D"
    - "\u201C\u5929\u6C14\u9884\u62A5\uFF1A\u4ECA\u591C\u6709\u96EA\uFF0C\u6C14\u6E29\u96F6\u4E0B\u5341\u4E5D\u5EA6\u3002\u660E\u65E5\u8F6C\u6674\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u201D"
    - "\u201C\u5929\u6C14\u9884\u62A5\uFF1A\u4ECA\u591C\u6709\u96EA\uFF0C\u6C14\u6E29\u96F6\u4E0B\u5341\u4E5D\u5EA6\u3002\u660E\u65E5\u8F6C\u6674\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u8BF7\u5E02\u6C11\u51CF\u5C11\u5916\u51FA\u3002\u201D"
  - id: 10
    name: "\u6C99\u53D1"
    pinyin: shafa
    room: "\u5BA2\u5385"
    tags:
    - "\u5750\u5177"
    - "\u5E03"
    clues:
    - "\u892A\u8272\u7684\u65E7\u6C99\u53D1\u3002\u60A0\u95F2\u7684\u65F6\u5019\uFF0C\u6211\u559C\u6B22\u5750\u5728\u4E0A\u9762\u53D1\u5446\uFF0C\u4EAB\u53D7\u88AB\u67D4\u8F6F\u5E03\u6599\u5305\u88F9\u7684\u611F\u89C9\uFF0C\u597D\u50CF\u8FD9\u6837\u5C31\u80FD\u6682\u65F6\u9003\u79BB\u4E16\u754C\u7684\u55A7\u56A3\u3002"
  - id: 11
    name: "\u8336\u51E0"
    pinyin: chaji
    room: "\u5BA2\u5385"
    tags:
    - "\u6728"
    clues:
    - "\u8336\u51E0\u3002\u6B63\u5E38\u5BA2\u5385\u5E94\u8BE5\u6709\u7684\u4E1C\u897F\uFF0C\u8FD9\u5C31\u662F\u5B83\u51FA\u73B0\u5728\u8FD9\u91CC\u7684\u552F\u4E00\u7406\u7531\u3002\u5373\u4F7F\u5E73\u65F6\u5E76\u4E0D\u4F1A\u6709\u5BA2\u4EBA\u9700\u8981\u5B83\u6765\u63A5\u5F85\u8336\u6C34\u3002"
